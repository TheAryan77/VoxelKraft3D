// Voxel Kraft shop. Money is stored in paise (integers) to avoid rounding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (via Vercel) provides both: pooled for the app, direct for migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/* ---------------------------------- Auth ---------------------------------- */

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  conversations Conversation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/* -------------------------------- Customers ------------------------------- */

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* --------------------------------- Catalogue ------------------------------- */

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  /// Price in paise (₹1 = 100).
  price        Int
  /// Optional "was" price in paise, shown struck through.
  compareAt    Int?
  images       String[]
  colors       String[]
  material     String?
  /// Printed to order: days from order to dispatch.
  leadTimeDays Int      @default(3)
  /// null = made to order (no stock limit).
  stock        Int?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  categoryId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId, isActive])
}

/* ---------------------------------- Orders --------------------------------- */

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  /// Human-friendly order number, e.g. VK-1001.
  number            Int           @unique @default(autoincrement())
  userId            String
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  subtotal          Int
  shipping          Int
  total             Int
  /// Snapshot of the delivery address at checkout.
  shipName          String
  shipPhone         String
  shipLine1         String
  shipLine2         String?
  shipCity          String
  shipState         String
  shipPincode       String
  /// Customisation request / note. The customer can edit it until printing starts.
  customerNote      String?
  courier           String?
  trackingNumber    String?
  trackingUrl       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  items         OrderItem[]
  events        OrderEvent[]
  conversations Conversation[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  /// Snapshots, so old orders still read correctly if a product changes.
  name      String
  image     String?
  color     String?
  unitPrice Int
  quantity  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

/// Tracking timeline: one row per status change or note.
model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  status    OrderStatus?
  note      String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/* ------------------------------ Customer care ------------------------------ */

enum ConversationStatus {
  OPEN
  CLOSED
}

enum Sender {
  CUSTOMER
  ADMIN
}

model Conversation {
  id            String             @id @default(cuid())
  userId        String
  orderId       String?
  subject       String
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  /// Unread flags for each side.
  adminUnread   Boolean            @default(true)
  customerUnread Boolean           @default(false)
  createdAt     DateTime           @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  sender         Sender
  body           String
  /// Photo / video URLs (proof for exchange requests, etc.).
  attachments    String[] @default([])
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
