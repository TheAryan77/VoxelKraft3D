# Copy to .env.local for local development, or add these in Vercel →
# Project → Settings → Environment Variables.

# ---------- Shop database (Neon Postgres) ----------
# Added automatically when you connect Neon from Vercel → Storage.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------- Sign-in (Auth.js + Google) ----------
# Any long random string: `npx auth secret` generates one.
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Who gets the /admin dashboard (comma-separated Google emails).
ADMIN_EMAILS=
# Local only: sign in with any email without Google. Never set in production.
# AUTH_DEV_LOGIN=true

# ---------- Payments (Razorpay) ----------
# Without these, checkout offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → https://<your-domain>/api/razorpay/webhook
# (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Product photos (Vercel Blob) ----------
# Added automatically when you create a Blob store from Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# ---------- Emails to the shop owner (Resend) ----------
# New orders, new messages and quote requests. Without these they're only logged.
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Voxel Kraft <orders@your-domain.com>"
QUOTE_TO_EMAIL=you@example.com

# ---------- 100-day challenge reels ----------
# Long-lived Instagram API token for @voxelkraft.in (refresh every ~60 days).
INSTAGRAM_ACCESS_TOKEN=

# Live 3D preview of uploaded STL files in the quote form.
NEXT_PUBLIC_FEATURE_STL_PREVIEW=false
